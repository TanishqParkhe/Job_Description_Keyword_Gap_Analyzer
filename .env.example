# Document limits and OCR
MAX_UPLOAD_SIZE_MB=15
MAX_DOCUMENT_PAGES=40
MAX_DOCX_UNCOMPRESSED_MB=50
MAX_IMAGE_PIXELS=40000000
OCR_TIMEOUT_SECONDS=30
MAX_TEXT_CHARACTERS=250000
ENABLE_OCR=true
OCR_DPI=220
OCR_LANGUAGE=eng
# Optional explicit Windows path; leave blank when tesseract is in PATH.
TESSERACT_CMD=

# Optional local AI coach
OLLAMA_MODEL=llama3.2:1b
FAST_OLLAMA_MODEL=llama3.2:1b
DEEP_OLLAMA_MODEL=llama3.2:1b
OLLAMA_HOST=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=220
LLM_TIMEOUT_SECONDS=90
MASK_PII_BEFORE_LLM=true

# HR screening
DEFAULT_HR_THRESHOLD=60
MAX_BULK_RESUMES=500
BULK_WORKERS=4
MAX_ZIP_SIZE_MB=300
MAX_ZIP_UNCOMPRESSED_MB=800
MAX_ZIP_COMPRESSION_RATIO=120
